NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API (the public pay page).
CORS_ORIGINS=http://localhost:5173

# Supabase (Project settings -> API). Required when NODE_ENV=production.
# The service-role key bypasses RLS: server-side only, never in the mobile app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty for projects using asymmetric JWT signing keys (verified via JWKS, recommended).
# Set only for legacy projects that sign access tokens with HS256 (Settings -> API -> JWT secret).
SUPABASE_JWT_SECRET=

# Direct Postgres connection (Supabase: Project settings -> Database -> connection string).
# Queries bypass RLS and are scoped by business_id in code. Required.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/invoiceflow

# Public base URL of this API as customers see it. Invoice links are PUBLIC_APP_URL/pay/<token>.
PUBLIC_APP_URL=http://localhost:4000
# HMAC key for invoice share links (min 32 chars, required in production). Generate with:
#   openssl rand -base64 48
# Rotating it invalidates every link already sent.
PUBLIC_LINK_SECRET=

# Email via Resend (https://resend.com). Without a key, emails are only logged (development).
# EMAIL_FROM must use a domain you have verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=InvoiceFlow <onboarding@resend.dev>

# Optional rate limits
# RATE_LIMIT_PER_MINUTE=120
# PUBLIC_RATE_LIMIT_PER_MINUTE=60
# SEND_RATE_LIMIT_PER_10_MIN=20

# ---- Stripe (online payments). Leave unset to disable online payments. ----
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard -> Developers -> Webhooks -> endpoint {PUBLIC_APP_URL}/v1/payments/webhook
# events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, charge.refunded
STRIPE_WEBHOOK_SECRET=
# Platform fee per online payment in basis points (250 = 2.5%). Stripe's own fees are charged to you.
PLATFORM_FEE_BPS=0
# Apple Pay: paste the contents of Stripe's domain association file (served at /.well-known/...).
APPLE_PAY_DOMAIN_ASSOCIATION=
# PAYMENT_INTENT_RATE_LIMIT_PER_MINUTE=10
