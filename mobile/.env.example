# Only EXPO_PUBLIC_* values are bundled into the app, so they are visible to anyone.
# Never put the service-role key or Stripe secret key here.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Expo/EAS project id (run `eas init`). Required to obtain push tokens on a real device.
EXPO_PUBLIC_EAS_PROJECT_ID=
